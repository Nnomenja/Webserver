#include <iostream>
#include <fstream>
#include <string>

int main() {
    std::ifstream file("config.conf");

    if (!file.is_open()) {
        std::cerr << "Error opening file\n";
        return 1;
    }

    std::string line;
    while (std::getline(file, line)) {
        std::cout << line << std::endl;
    }

    file.close();
    return 0;
}